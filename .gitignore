# SyncCode .gitignore

# Dependencies
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
client/dist/
client/build/
server/dist/
server/build/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
server/temp/
*.log
logs/

# Test results
tests/*-results.json

# PM2
.pm2/

# Docker volumes
.docker/

# Antigravity artifacts (don't commit)
.gemini/

